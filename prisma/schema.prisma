generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("ذكاء اصطناعي")
  price         String
  originalPrice String?
  billingPeriod String   @default("شهرياً")
  description   String
  features      String   // JSON stringified string[]
  badge         String?
  popular       Boolean  @default(false)
  imageUrl      String?
  iconType      String   @default("gemini")
  whatsappMsg   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id             String   @id @default("default")
  whatsappNumber String   @default("201021510826")
  facebookUrl    String   @default("https://www.facebook.com/share/1NbRrA56uz/")
  usdToEgpRate   Float    @default(50.0)
  updatedAt      DateTime @updatedAt
}
